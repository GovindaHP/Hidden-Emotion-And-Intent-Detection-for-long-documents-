  "hidden_emotion_rules": [
    {
      "domain": "payroll",
      "pattern": "\\b(attendance|salary|payroll|deduction|withheld|timesheet|biometric|payslip|wages)\\b.*\\b(discrepancy|evidence|investigated|corrected|restored|reimbursed|relief|closure)\\b",
      "hidden_emotion": "Underlying Concern for Financial Security & Desire for Fair Resolution"
    },
    {
      "domain": "project",
      "pattern": "\\b(extension|deadline|submitted|finally|relief|proud|team|project|capstone|faculty|professor)\\b.*\\b(anxiety|stress|bugs|pressure|sleepless|exhausted)\\b",
      "hidden_emotion": "Relieved Pride Masking Underlying Academic Exhaustion & Resilience"
    },
    {
      "domain": "consumer",
      "pattern": "\\b(return|refund|policy|unfortunate|procedure|straightforward|misunderstanding|device|troubleshooting)\\b.*\\b(rather|hope|believe|applicable)\\b",
      "hidden_emotion": "Calm Determination Masking Loss of Consumer Trust & Disappointment"
    },
    {
      "domain": "medical",
      "pattern": "\\b(cardiologist|oncologist|biopsy|pathology report|cardiac mri|ct scan|clinical diagnosis|physician consultation)\\b.*\\b(anxiety|fear|worry|dread|vulnerability|relief|reassurance|hope)\\b",
      "hidden_emotion": "Masked Health Vulnerability & Prognosis Apprehension Behind Clinical Inquiries"
    },
    {
      "domain": "medical_postop",
      "pattern": "\\b(post-op|post-operative|orthopedic surgery|surgical incision|wound healing|rehabilitation protocol)\\b.*\\b(pain|mobility|healing|progress|relief)\\b",
      "hidden_emotion": "Guarded Resilience & Hope for Physical Recovery"
    },
    {
      "domain": "medical_rx",
      "pattern": "\\b(antihypertensive|prescription medication|dosage adjustment|drug interaction|adverse side effects)\\b",
      "hidden_emotion": "Vulnerable Health Apprehension over Medication Efficacy & Safety"
    },
    {
      "domain": "academic_grievance",
      "pattern": "\\b(strict rules|permission to go out|management fee|extra class|cannot code|opinion of students)\\b",
      "hidden_emotion": "Systemic Disillusionment & Academic Distress"
    },
    {
      "domain": "civility_frustration",
      "pattern": "\\b(fine|okay|whatever|no problem)\\b.*\\b(anyway|suppose|nevermind)\\b",
      "hidden_emotion": "Repressed Frustration Behind Civility"
    },
    {
      "domain": "dispute",
      "pattern": "\\b(as expected|of course|naturally)\\b.*\\b(failed|delayed|wrong)\\b",
      "hidden_emotion": "Cynical Resignation & Distrust"
    }
  ]
}